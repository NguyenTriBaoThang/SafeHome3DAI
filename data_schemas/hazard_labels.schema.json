{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hazard_labels.schema.json",
  "title": "B03 - nhãn mối nguy theo ảnh (một file = mảng bản ghi của MỘT người gán)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["image_id", "household_id", "room_type", "annotator_id", "labeled_at", "guideline_version", "hazards", "objects"],
    "properties": {
      "image_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
      "household_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
      "room_type": {"enum": ["BEDROOM", "BATHROOM"]},
      "annotator_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
      "labeled_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[0-9:.+Z-]+)?$"},
      "guideline_version": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
      "hazards": {
        "type": "object",
        "description": "Khóa = RISK-001..008, chỉ gồm các RISK áp dụng cho room_type (script kiểm thêm).",
        "propertyNames": {"pattern": "^RISK-00[1-8]$"},
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "evidence_note"],
          "properties": {
            "state": {"enum": ["present", "absent", "uncertain", "not_assessable"]},
            "evidence_note": {"type": "string"}
          }
        }
      },
      "objects": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "bbox", "visibility"],
          "properties": {
            "class": {"enum": ["bed", "rug", "electrical_cable", "chair", "sink", "toilet", "grab_bar"]},
            "bbox": {"type": "array", "minItems": 4, "maxItems": 4,
                     "items": {"type": "number", "minimum": 0, "maximum": 1},
                     "description": "[xMin, yMin, xMax, yMax] chuẩn hóa 0..1; script kiểm xMax>xMin, yMax>yMin"},
            "visibility": {"enum": ["full", "partial"]}
          }
        }
      }
    }
  }
}
