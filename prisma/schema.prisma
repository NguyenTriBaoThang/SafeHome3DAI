generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(uuid())
  name          String
  description   String?
  dataPartition String   @default("REAL") // "REAL" | "DEMO"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  homes         Home[]
}

model Home {
  id                    String   @id @default(uuid())
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                  String
  address               String?
  targetResidentProfile String?  // e.g. "Người cao tuổi 75 tuổi, giảm thị lực, đi lại cần hỗ trợ"
  dataPartition         String   @default("REAL") // "REAL" | "DEMO"
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  rooms                 Room[]
}

model Room {
  id                String               @id @default(uuid())
  homeId            String
  home              Home                 @relation(fields: [homeId], references: [id], onDelete: Cascade)
  name              String
  roomType          String               // "BEDROOM" | "BATHROOM" | "LIVING_ROOM"
  width             Float                @default(4.0)
  length            Float                @default(5.0)
  height            Float                @default(2.8)
  floorMaterial     String               @default("WOOD") // "WOOD" | "CERAMIC_TILE" | "NON_SLIP_VINYL"
  lightingLevel     Float                @default(150.0)  // Lux: e.g. 50 (dim/night), 150 (normal), 300 (bright)
  isWet             Boolean              @default(false)
  isSlipResistant   Boolean              @default(false)
  grabBarsCount     Int                  @default(0)
  dataPartition     String               @default("REAL") // "REAL" | "DEMO"
  persistenceStatus String               @default("saved") // "saved" | "pending" | "failed"
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  sceneObjects      SceneObject[]
  assessments       Assessment[]
  scenarios         SimulationScenario[]
}

model SceneObject {
  id                  String   @id @default(uuid())
  roomId              String
  room                Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name                String
  category            String   // "FURNITURE" | "RUG" | "CABLE" | "LIGHTING" | "SAFETY_DEVICE" | "OBSTACLE"
  modelType           String   // "bed", "nightstand", "wardrobe", "rug", "cable", "toilet", "shower", "grab_bar", "sofa", "coffee_table", "lamp"
  positionX           Float    @default(0.0)
  positionY           Float    @default(0.0)
  positionZ           Float    @default(0.0)
  rotationX           Float    @default(0.0)
  rotationY           Float    @default(0.0)
  rotationZ           Float    @default(0.0)
  scaleX              Float    @default(1.0)
  scaleY              Float    @default(1.0)
  scaleZ              Float    @default(1.0)
  width               Float    @default(1.0)
  length              Float    @default(1.0)
  height              Float    @default(1.0)
  isWalkwayObstacle   Boolean  @default(false)
  isFixed             Boolean  @default(false)
  isLoose             Boolean  @default(false)
  isSlippery          Boolean  @default(false)
  isActive            Boolean  @default(true)
  customProperties    String?  // JSON string for specific properties
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SimulationScenario {
  id               String          @id @default(uuid())
  roomId           String
  room             Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  isBaseline       Boolean         @default(false)
  parentScenarioId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  assessments      Assessment[]
  snapshots        SceneSnapshot[]
}

model SceneSnapshot {
  id           String             @id @default(uuid())
  scenarioId   String
  scenario     SimulationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  snapshotData String             // JSON of room state and scene objects
  createdAt    DateTime           @default(now())
}

model Assessment {
  id                String             @id @default(uuid())
  roomId            String
  room              Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  scenarioId        String?
  scenario          SimulationScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  assessmentDate    DateTime           @default(now())
  totalHazards      Int                @default(0)
  resolvedHazards   Int                @default(0)
  remainingHazards  Int                @default(0)
  newHazards        Int                @default(0)
  safetyScore       Float              @default(70.0) // 0-100 heuristic index
  status            String             @default("COMPLETED")
  dataPartition     String             @default("REAL") // "REAL" | "DEMO"
  persistenceStatus String             @default("saved") // "saved" | "pending" | "failed"
  idempotencyKey    String?            @unique
  notes             String?
  findings          HazardFinding[]
}

model HazardFinding {
  id                String          @id @default(uuid())
  assessmentId      String
  assessment        Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  hazardType        String          // e.g. "LOOSE_RUG", "CABLE_CROSSING", "OBSTACLE_ROUTE", "POOR_LIGHTING", "WET_FLOOR", "MISSING_GRAB_BAR", "CLUTTERED_PATH", "UNSTABLE_FURNITURE"
  title             String
  description       String
  severityCategory  String          // "LOW" | "MEDIUM" | "HIGH"
  detectionRuleId   String          // e.g. "RULE_RUG_01", "RULE_CABLE_02", "RULE_LIGHT_03", "RULE_BATH_WET_04", "RULE_BATH_GRAB_05", "RULE_PATH_OBST_06"
  evidence          String          // JSON or detailed text description of spatial measurement
  recommendationText String
  targetObjectId    String?         // Reference to SceneObject.id if applicable
  targetArea        String?         // JSON of bounding zone coordinates
  status            String          @default("ACTIVE") // "ACTIVE" | "RESOLVED" | "IGNORED"
  recommendations   Recommendation[]
}

model Recommendation {
  id             String        @id @default(uuid())
  findingId      String
  finding        HazardFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  title          String
  description    String
  priority       String        // "LOW" | "MEDIUM" | "HIGH"
  practicalSteps String        // Markdown or bullet points
  estimatedCost  String?       // e.g. "Dưới 100.000 VNĐ", "100.000 - 500.000 VNĐ"
  referenceIds   String?       // JSON array of KnowledgeSource IDs
}

model KnowledgeSource {
  id              String             @id @default(uuid())
  title           String
  organization    String             // "WHO" | "CDC" | "BỘ Y TẾ VIỆT NAM" | "NCOA"
  publisher       String?            // Official publisher alias
  url             String
  officialUrl     String?            // Canonical URL alias
  publicationDate String
  language        String             @default("vi") // "vi" | "en"
  documentType    String             @default("GUIDELINE") // "GUIDELINE" | "STANDARD" | "RESEARCH"
  version         String?            @default("1.0")
  approvalStatus  String             @default("APPROVED") // "APPROVED" | "PENDING" | "REJECTED"
  ingestionStatus String             @default("INDEXED")  // "INDEXED" | "FAILED" | "PENDING"
  contentHash     String?
  retrievedAt     DateTime           @default(now())
  lastVerifiedAt  DateTime           @default(now())
  sourceStatus    String             @default("VERIFIED") // "VERIFIED" | "CURATED"
  passages        KnowledgePassage[]
}

model KnowledgePassage {
  id           String          @id @default(uuid())
  sourceId     String
  source       KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  section      String
  passageText  String
  pageNumber   Int?
  startOffset  Int?
  endOffset    Int?
  contentHash  String?
  embeddingRef String?
  keywords     String          // JSON array or comma separated
  relatedRules String?         // JSON array of Rule IDs
}

model Conversation {
  id        String                @id @default(uuid())
  title     String                @default("Tư vấn an toàn phòng ngừa té ngã")
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  messages  ConversationMessage[]
}

model ConversationMessage {
  id                  String           @id @default(uuid())
  conversationId      String
  conversation        Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role                String           // "user" | "assistant" | "system"
  content             String
  evidenceStatus      String?          @default("SUPPORTED") // "SUPPORTED" | "PARTIALLY_SUPPORTED" | "INSUFFICIENT_EVIDENCE" | "CONFLICTING_EVIDENCE" | "OUT_OF_SCOPE" | "EMERGENCY"
  responseMode        String?          @default("LOCAL_GROUNDED") // "LOCAL_GROUNDED" | "LLM_GENERATED" | "REFUSAL_INSUFFICIENT" | "EMERGENCY_ESCALATION"
  modelProvider       String?          @default("local-deterministic")
  modelName           String?          @default("curated-rag-engine-v1")
  warnings            String?          // JSON array
  retrievedPassageIds String?          // JSON array
  citations           String?          // JSON array (legacy/serialized cache)
  isFallback          Boolean          @default(false)
  createdAt           DateTime         @default(now())
  citationsList       AnswerCitation[]
}

model AnswerCitation {
  id                String              @id @default(uuid())
  messageId         String
  message           ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sourceId          String
  passageId         String?
  citationNumber    Int                 @default(1)
  documentTitle     String
  publisher         String
  sectionTitle      String
  pageNumber        Int?
  supportingExcerpt String
  officialUrl       String?
  createdAt         DateTime            @default(now())
}

// =====================================================================
// MODULE: SAFEHOME AI GUIDED HOME SAFETY SURVEY
// =====================================================================

model HomeSurvey {
  id                String             @id @default(uuid())
  name              String             @default("Khảo sát không gian sống mới")
  ownerId           String?
  targetResident    String?            // e.g. "Người cao tuổi 75 tuổi, đi lại chậm"
  status            String             @default("IN_PROGRESS") // "IN_PROGRESS" | "COMPLETED" | "DRAFT"
  dataPartition     String             @default("REAL") // "REAL" | "DEMO"
  persistenceStatus String             @default("saved") // "saved" | "pending" | "failed"
  consentGiven      Boolean            @default(true)
  generalNotes      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  rooms             SurveyRoom[]
  auditEvents       SurveyAuditEvent[]
}

model SurveyRoom {
  id                  String             @id @default(uuid())
  surveyId            String
  survey              HomeSurvey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  roomType            String             // "BEDROOM" | "BATHROOM" | "LIVING_ROOM" | "KITCHEN"
  name                String             // e.g. "Phòng ngủ chính", "Nhà vệ sinh tầng 1"
  status              String             @default("NOT_STARTED") // "NOT_STARTED" | "IN_PROGRESS" | "NEEDS_CONFIRMATION" | "COMPLETED"
  questionBankVersion String             @default("1.0.0")
  currentQuestionId   String?
  completedAt         DateTime?
  linked3dRoomId      String?            // Reference to existing Room.id for 3D digital twin integration
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  answers             SurveyAnswer[]
  profile             SurveyRoomProfile?
  findings            SurveyFinding[]
  photos              SurveyRoomPhoto[]
}

model SurveyAnswer {
  id                 String     @id @default(uuid())
  roomId             String
  room               SurveyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  questionId         String     // e.g. "BED_001", "BED_006", "BATH_005"
  category           String     // "BASIC" | "LIGHTING" | "FLOOR" | "CABLE" | "OBSTACLE" | "GRAB_BAR" | "ACCESSIBILITY"
  value              String     // JSON-serialized answer value
  answerSource       String     @default("USER_SELECTED") // "USER_SELECTED" | "USER_FREE_TEXT" | "USER_ESTIMATED" | "NLP_EXTRACTED" | "VISION_SUGGESTED"
  confirmationStatus String     @default("CONFIRMED") // "CONFIRMED" | "PENDING_CONFIRMATION" | "UNKNOWN"
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([roomId, questionId])
}

model SurveyRoomProfile {
  id                String     @id @default(uuid())
  roomId            String     @unique
  room              SurveyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  profileJson       String     // Strongly typed RoomProfile JSON payload
  version           String     @default("1.0.0")
  completenessScore Float      @default(0.0) // 0 - 100%
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model SurveyFinding {
  id                  String     @id @default(uuid())
  roomId              String
  room                SurveyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  ruleId              String     // e.g. "RULE_BED_001", "RULE_BATH_001"
  title               String
  category            String     // "RUG" | "CABLE" | "LIGHTING" | "OBSTACLE" | "BATH_SLIP" | "GRAB_BAR" | "ACCESSIBILITY"
  priority            String     // "CAN_UU_TIEN_KIEM_TRA" | "NEN_XEM_XET_CAI_THIEN" | "CAN_THEM_THONG_TIN"
  observedEvidence    String
  recommendation      String
  supportingSourceIds String?    // JSON array of KnowledgeSource IDs
  status              String     @default("ACTIVE") // "ACTIVE" | "ACKNOWLEDGED" | "RESOLVED"
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model SurveyRoomPhoto {
  id              String     @id @default(uuid())
  roomId          String
  room            SurveyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fileUrl         String
  caption         String?
  detectedObjects String?    // JSON array of AI Vision annotations
  createdAt       DateTime   @default(now())
}

model SurveyAuditEvent {
  id            String     @id @default(uuid())
  surveyId      String
  survey        HomeSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  roomId        String?
  eventType     String     // "SURVEY_CREATED" | "ANSWER_SAVED" | "ANSWER_EDITED" | "DEPENDENT_INVALIDATED" | "PROFILE_UPDATED" | "SURVEY_COMPLETED"
  changedFields String?    // JSON metadata
  timestamp     DateTime   @default(now())
}


// =====================================================================
// MODULE: SAFEHOME MULTIMODAL AI VISION & SMART HOME IMAGE ASSESSMENT
// =====================================================================

model RoomImage {
  id            String           @id @default(uuid())
  roomId        String
  storageKey    String           // e.g. "/uploads/vision/room-1_img1.jpg" or data URI
  imageWidth    Int?
  imageHeight   Int?
  viewpoint     String           @default("ENTRANCE") // "ENTRANCE" | "OPPOSITE_CORNER" | "WALKWAY" | "CLOSE_UP" | "OTHER"
  caption       String?
  uploadedBy    String?          @default("Gia đình")
  consentStatus Boolean          @default(true)
  createdAt     DateTime         @default(now())
  analyses      VisionAnalysis[]
}

model VisionAnalysis {
  id             String              @id @default(uuid())
  roomId         String
  imageId        String
  image          RoomImage           @relation(fields: [imageId], references: [id], onDelete: Cascade)
  modelId        String              @default("safehome-vision-v1")
  modelVersion   String              @default("1.0.0")
  analysisStatus String              @default("COMPLETED") // "QUEUED" | "PROCESSING" | "COMPLETED" | "FAILED" | "CANCELLED"
  errorCode      String?
  startedAt      DateTime            @default(now())
  completedAt    DateTime?
  detections     ObjectDetection[]
  observations   VisionObservation[]
}

model ObjectDetection {
  id                 String         @id @default(uuid())
  analysisId         String
  analysis           VisionAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  category           String         // "bed", "chair", "table", "cabinet", "door", "toilet", "sink", "bathtub", "sofa", "rug", "electrical_cable", "grab_bar", "obstacle_route", "threshold_step"
  originalLabel      String
  userLabel          String?
  confidence         Float          @default(0.85)
  bboxJson           String         // JSON [xMin, yMin, xMax, yMax] normalized 0..1
  source             String         @default("OBJECT_DETECTOR") // "OBJECT_DETECTOR" | "VISION_LANGUAGE_MODEL" | "MANUAL_ANNOTATION"
  verificationStatus String         @default("PENDING_REVIEW") // "PENDING_REVIEW" | "CONFIRMED" | "CORRECTED" | "REJECTED"
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model VisionObservation {
  id                   String               @id @default(uuid())
  analysisId           String
  analysis             VisionAnalysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  observationType      String               // "OBSTACLE_CANDIDATE" | "RUG_OBSERVED" | "CABLE_OBSERVED" | "GRAB_BAR_UNCERTAIN" | "WET_SURFACE_UNCERTAIN" | "LEVEL_TRANSITION"
  description          String
  evidenceJson         String?              // JSON metadata
  uncertaintyType      String               @default("SPATIAL_UNCERTAINTY") // "SPATIAL_UNCERTAINTY" | "CONDITION_UNCERTAINTY" | "OCCLUSION"
  requiresConfirmation Boolean              @default(true)
  verificationStatus   String               @default("PENDING_REVIEW") // "PENDING_REVIEW" | "CONFIRMED" | "REJECTED"
  surveyQuestionId     String?              // e.g. "BED_006", "BED_008", "BATH_005"
  clarifications       VisionClarification[]
  createdAt            DateTime             @default(now())
}

model VisionClarification {
  id               String             @id @default(uuid())
  roomId           String
  observationId    String?
  observation      VisionObservation? @relation(fields: [observationId], references: [id], onDelete: SetNull)
  surveyQuestionId String             // e.g. "BED_006", "BED_007", "BED_008", "BATH_003", "BATH_005"
  questionText     String
  optionsJson      String             // JSON array of options
  status           String             @default("PENDING") // "PENDING" | "ANSWERED" | "DISMISSED"
  userResponse     String?            // JSON value of response
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model VisionRoomFact {
  id                 String   @id @default(uuid())
  roomId             String
  fieldPath          String   // e.g. "rugs.present", "rugs.secured", "cables.crossingWalkway"
  proposedValue      String   // JSON string
  confirmedValue     String?  // JSON string
  evidenceReference  String?  // imageId or detectionId
  verificationStatus String   @default("CONFIRMED") // "AI_PROPOSED" | "CONFIRMED" | "CORRECTED" | "REJECTED"
  updatedAt          DateTime @updatedAt

  @@unique([roomId, fieldPath])
}

model VisionAuditEvent {
  id         String   @id @default(uuid())
  roomId     String
  actionType String   // "IMAGE_UPLOADED" | "DETECTION_CONFIRMED" | "DETECTION_CORRECTED" | "FACT_SYNCED" | "SURVEY_SYNCED"
  objectId   String?
  oldValue   String?
  newValue   String?
  actorId    String?  @default("USER")
  timestamp  DateTime @default(now())
}

model PersistenceAuditEvent {
  id             String   @id @default(uuid())
  accountId      String   @default("system")
  dataPartition  String   @default("REAL") // "REAL" | "DEMO"
  resourceType   String   // "ROOM" | "ASSESSMENT" | "SURVEY" | "SIMULATION" | "REPORT_EXPORT"
  resourceId     String
  roomId         String?
  action         String   // "CREATED" | "UPDATED" | "DELETED" | "DUPLICATE_REPLAYED" | "WRITE_FAILED" | "DEMO_EXPORT_BLOCKED" | "CROSS_TENANT_BLOCKED"
  status         String   // "saved" | "pending" | "failed" | "blocked"
  idempotencyKey String?
  details        String?
  createdAt      DateTime @default(now())

  @@index([accountId, roomId])
  @@index([resourceId])
}
