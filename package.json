{
  "name": "safehome-3d-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:rag:a09": "node scripts/run-rag-benchmark-a09.cjs",
    "qa:gates": "node scripts/ci/quality-gates.cjs",
    "typecheck": "tsc --noEmit",
    "dev:experience": "node scripts/run-experience.cjs dev",
    "build:experience": "node scripts/run-experience.cjs build",
    "start:experience": "node scripts/run-experience.cjs start",
    "test:experience": "vitest run --config vitest.experience.config.ts tests/homeExperience.test.ts tests/modelPlacement.test.ts tests/dollhouseReferenceScene.test.ts tests/spatialValidationEngine.test.ts tests/simulationUndoRedo.test.ts tests/realisticReconstruction.test.ts tests/riskEngine.test.ts tests/visionIntegration.test.ts",
    "test:experience:browser": "node scripts/verify_cinematic_experience.cjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "test:vision": "vitest run --config vitest.experience.config.ts tests/visionProviders.test.ts tests/structuredGemini.test.ts tests/visionState.test.ts tests/visionProfile.test.ts tests/visionRoutes.test.ts tests/visionEngine.test.ts tests/visionIntegration.test.ts tests/geminiVision.test.ts tests/workflowVision.test.ts tests/itemHazardAssessment.test.ts",
    "test:completion:http": "node scripts/completion/http-smoke.cjs",
    "test:completion:browser": "node scripts/completion/browser.cjs",
    "build:completion": "prisma generate && node scripts/run-experience.cjs build .scratch/completion-production",
    "start:completion": "node scripts/run-experience.cjs start .scratch/completion-production"
  },
  "dependencies": {
    "@google/genai": "^3.4.0",
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@xyflow/react": "^12.0.4",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.395.0",
    "next": "15.5.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.3.0",
    "three": "^0.165.0",
    "three-stdlib": "^2.30.4",
    "zod": "4.6.7",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "^0.165.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.33",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.5"
  }
}
