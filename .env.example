# SafeHome 3D AI — Cấu hình môi trường (Environment Variables)

# 1. Cơ sở dữ liệu SQLite cục bộ (Mặc định Zero-Config)
DATABASE_URL="file:./dev.db"

# 2. Cấu hình AI / LLM Provider (SafeHome Copilot)
# Khi đặt false hoặc không có API key, hệ thống chạy hoàn toàn bằng Local Grounded Engine (100% Offline & Deterministic)
ENABLE_EXTERNAL_LLM="false"
LLM_PROVIDER="gemini" # AI Agent hiện hỗ trợ Gemini function calling
GEMINI_MODEL="gemini-3.5-flash-lite" # Có thể thay bằng model Gemini hỗ trợ function calling của tài khoản
LLM_MODEL="" # Tương thích cấu hình cũ; chỉ dùng khi GEMINI_MODEL chưa được đặt
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_AGENT_MAX_STEPS="4" # 1-8 vòng công cụ, tối đa 8 lời gọi và 1 lượt tổng hợp cuối
AI_AGENT_TIMEOUT_MS="20000" # 1000-60000 ms cho toàn bộ vòng lặp Agent

# 3. Cấu hình RAG Retrieval & Sufficiency Thresholds
RAG_TOP_K="4"
RAG_MIN_SCORE="1.0"
RAG_STRICT_CITATION="true"

# 4. Môi trường chạy
NODE_ENV="development"
PORT=3000
