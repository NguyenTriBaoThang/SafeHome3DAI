# SafeHome 3D AI — Cấu hình môi trường (Environment Variables)

# 1. Database cũ chỉ dùng cho công cụ quản trị/kiểm thử; không tự gán cho tài khoản.
DATABASE_URL="file:./dev.db"
# Mỗi tài khoản gia đình có SQLite và ảnh riêng. Cần volume bền vững và một Node server.
SAFEHOME_PRIVATE_DIR=".private"
# Khi triển khai qua HTTPS/proxy, đặt đúng origin công khai để kiểm tra Origin và Secure cookie.
# SAFEHOME_APP_ORIGIN="https://safehome.example.com"

# 2. Cấu hình AI / LLM Provider (SafeHome Copilot)
# Khi đặt false, AI Agent dùng Local Grounded Engine. Vision được cấu hình riêng ở dưới.
ENABLE_EXTERNAL_LLM="false"
LLM_PROVIDER="gemini" # AI Agent hiện hỗ trợ Gemini function calling
GEMINI_MODEL="gemini-3.5-flash-lite" # Có thể thay bằng model Gemini hỗ trợ function calling của tài khoản
LLM_MODEL="" # Tương thích cấu hình cũ; chỉ dùng khi GEMINI_MODEL chưa được đặt
GEMINI_API_KEY=""

# Vision server-side: gemini | local. Không tự đổi provider khi lỗi.
VISION_PROVIDER="gemini"
VISION_TIMEOUT_MS="60000" # Một attempt; JSON Schema + runtime validation. Khoảng 1000..120000 ms.
# Chỉ dùng khi VISION_PROVIDER=local; FastAPI cần ONNX đã vượt qua kiểm tra Giai đoạn 5.
LOCAL_DETECTOR_URL="http://127.0.0.1:8766"
# SAFEHOME_STAGE5_ONNX="models/stage5/rtdetr_r18/onnx"
OPENAI_API_KEY=""
AI_AGENT_MAX_STEPS="4" # 1-8 vòng công cụ, tối đa 8 lời gọi và 1 lượt tổng hợp cuối
AI_AGENT_TIMEOUT_MS="20000" # 1000-60000 ms cho toàn bộ vòng lặp Agent

# 3. Cấu hình RAG Retrieval & Sufficiency Thresholds
RAG_TOP_K="4"
RAG_MIN_SCORE="1.0"
RAG_STRICT_CITATION="true"

# 4. Môi trường chạy
NODE_ENV="development"
PORT=3000
