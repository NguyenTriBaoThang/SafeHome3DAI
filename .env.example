# SafeHome 3D AI - Cấu hình môi trường

# Cơ sở dữ liệu SQLite cục bộ (Mặc định zero-config)
DATABASE_URL="file:./dev.db"

# Tích hợp AI / LLM (Tùy chọn - Hệ thống tự động kích hoạt chế độ Cục bộ Fallback nếu không có key)
ENABLE_EXTERNAL_LLM="false"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Môi trường chạy
NODE_ENV="development"
PORT=3000

